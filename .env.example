# Runtime
PORT=3000
TRUST_PROXY_HOPS=0
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tessera
REDIS_URL=redis://localhost:6379

# Generate a random value of at least 32 characters. Never reuse a Stripe key.
API_KEY_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Prefer a restricted Stripe key with only the permissions this service needs.
STRIPE_SECRET_KEY=rk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_PRO=price_replace_with_pro
STRIPE_PRICE_WHALE=price_replace_with_whale

# Abuse and plan controls
REGISTER_RATE_LIMIT=5
REGISTER_RATE_WINDOW_MS=3600000
FREE_MONTHLY_LIMIT=100
FREE_RATE_WINDOW_MS=60000
PRO_MONTHLY_LIMIT=5000
PRO_RATE_WINDOW_MS=3000
WHALE_RATE_WINDOW_MS=0
